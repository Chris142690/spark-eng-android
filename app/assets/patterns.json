[
  {
    "pattern_id": "p-am",
    "cefr_target": "A1",
    "scenario": "daily",
    "formula": "I am + [名词/形容词]",
    "meaning_zh": "说明自己是谁、是什么状态。英语必须有 be 动词，中文「我很累」不能说 I very tired。",
    "examples": [
      {
        "en": "I am a student.",
        "cn": "我是学生。"
      },
      {
        "en": "I am tired today.",
        "cn": "我今天很累。"
      }
    ],
    "substitutions": [
      {
        "slot": "[身份]",
        "items": [
          "a student",
          "a teacher",
          "an engineer"
        ]
      },
      {
        "slot": "[状态]",
        "items": [
          "tired",
          "busy",
          "ready"
        ]
      }
    ],
    "prompt_zh": "用英语说：我是新来的。",
    "reference_answers": [
      "I am new.",
      "I'm new.",
      "I am new here.",
      "I'm new here."
    ],
    "required_vocab": [
      "new"
    ],
    "error_focus": [
      "漏掉 am（I new）",
      "am/is/are 混用"
    ],
    "collocations": [
      {
        "phrase": "be ready",
        "cn": "准备好"
      },
      {
        "phrase": "be busy with",
        "cn": "忙于"
      }
    ],
    "content_version": "v1"
  },
